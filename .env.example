APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Adresse publique des liens de partage des témoignages (défaut : https://testi.airid-africa.com).
SHARE_URL=https://testi.airid-africa.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=testiapp_backend_laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Témoignages en direct (LiveKit) — docs/fonctionnalites/lives.md
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Enregistrement des directs → témoignage vidéo (stockage compatible S3 : Cloudflare R2, AWS S3, Backblaze B2…)
LIVEKIT_RECORDING_S3_KEY=
LIVEKIT_RECORDING_S3_SECRET=
LIVEKIT_RECORDING_S3_BUCKET=
LIVEKIT_RECORDING_S3_REGION=auto
LIVEKIT_RECORDING_S3_ENDPOINT=
LIVEKIT_RECORDING_S3_PATH_STYLE=false
LIVEKIT_RECORDING_PUBLIC_URL=
# Facultatif : « public » si la lecture publique du bucket repose sur les ACL (AWS). Vide pour R2 / B2.
LIVEKIT_RECORDING_S3_VISIBILITY=

# Qualités des médias (ffmpeg + file d'attente) — docs/fonctionnalites/qualites-media.md
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MEDIA_TRANSCODING_ENABLED=true
MEDIA_TRANSCODE_TIMEOUT=1800
# Dossier de travail pour les fichiers sur S3 (enregistrements de directs). Vide = storage/app/transcode.
MEDIA_TEMP_DIR=
# Doit dépasser MEDIA_TRANSCODE_TIMEOUT, sinon une conversion longue est relancée en parallèle.
DB_QUEUE_RETRY_AFTER=1900

# Notifications push FCM (API HTTP v1) — docs/fonctionnalites/notifications-push.md
# Chemin du JSON du compte de service Firebase (console Firebase > Paramètres > Comptes de service).
# Hors du dossier public, jamais versionné. Vide = pas de push (notifications dans l'app inchangées).
FIREBASE_CREDENTIALS=
# Facultatif : sinon lu dans le fichier JSON.
FIREBASE_PROJECT_ID=
# Vide = activé si FIREBASE_CREDENTIALS est lisible ; false pour couper les push.
FCM_ENABLED=
